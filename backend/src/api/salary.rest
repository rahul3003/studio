### Get monthly salary by ID
GET {{baseUrl}}/salaries/monthly-salaries/{salaryId}
Authorization: Bearer {{jwt}}

### Get monthly salary by employee and month
GET {{baseUrl}}/salaries/employees/{{employeeId}}/monthly-salaries/2024/12
Authorization: Bearer {{jwt}}

### Get all monthly salaries for an employee
GET {{baseUrl}}/salaries/employees/{{employeeId}}/monthly-salaries
Authorization: Bearer {{jwt}}

### Get all monthly salaries for an employee (specific year)
GET {{baseUrl}}/salaries/employees/{{employeeId}}/monthly-salaries?year=2024
Authorization: Bearer {{jwt}}

### Get all monthly salaries with filters
GET {{baseUrl}}/salaries/monthly-salaries?year=2024&month=12&status=PENDING&page=1&limit=10
Authorization: Bearer {{jwt}}

### Update monthly salary
PUT {{baseUrl}}/salaries/monthly-salaries/{salaryId}
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "basicSalary": 55000,
  "hra": 22000,
  "remarks": "Updated salary for December 2024"
}

### Approve monthly salary
PATCH {{baseUrl}}/salaries/monthly-salaries/{salaryId}/approve
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "approvedBy": "admin@example.com",
  "remarks": "Salary approved for December 2024"
}

### Mark salary as paid
PATCH {{baseUrl}}/salaries/monthly-salaries/{salaryId}/mark-paid
Authorization: Bearer {{jwt}}

### Update payslip URL
PATCH {{baseUrl}}/salaries/monthly-salaries/{salaryId}/payslip
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "payslipUrl": "https://example.com/payslips/dec-2024-payslip.pdf"
}

### Delete monthly salary
DELETE {{baseUrl}}/salaries/monthly-salaries/{salaryId}
Authorization: Bearer {{jwt}}

### Get salary statistics
GET {{baseUrl}}/salaries/monthly-salaries/statistics?year=2024&month=12
Authorization: Bearer {{jwt}}

### Get salary statistics for entire year
GET {{baseUrl}}/salaries/monthly-salaries/statistics?year=2024
Authorization: Bearer {{jwt}} 